desc: 2x4x2 FFT Convolution of HRTF

slider1:0<0,1,1{Off,On}>Enable Processing

@init
fftsize = 1024;
half_fft = fftsize / 2;

// Memory Allocation Buffers
// 0..1023: Input Left FFT Buffer
// 1024..2047: Input Right FFT Buffer
// 2048..3071: Ring Buffer Left
// 3072..4095: Ring Buffer Right
// 4096+: HRTF Impulse/FFT Storage
buf_inL  = 0;
buf_inR  = fftsize;
ring_L   = fftsize * 2;
ring_R   = fftsize * 3;
hrtf_mem = fftsize * 4;

pos = 0;

@sample
slider1 ? (
    // Store incoming samples in delay/ring buffer
    ring_L[pos] = spl0;
    ring_R[pos] = spl1;

    pos += 1;

    // When buffer reaches fftsize / 2 (50% overlap-save block size)
    pos >= half_fft ? (
        pos = 0;

        // 1. Copy windowed/padded time domain samples to FFT buffers
        i = 0;
        loop(half_fft,
            buf_inL[i*2] = ring_L[i];
            buf_inL[i*2+1] = 0; // Imaginary part
            
            buf_inR[i*2] = ring_R[i];
            buf_inR[i*2+1] = 0;
            i += 1;
        );
        // Zero pad the second half for non-cyclic convolution
        loop(half_fft,
            buf_inL[i*2] = 0;
            buf_inL[i*2+1] = 0;
            buf_inR[i*2] = 0;
            buf_inR[i*2+1] = 0;
            i += 1;
        );

        // 2. Perform Forward Real/Complex FFT
        fft(buf_inL, fftsize);
        fft(buf_inR, fftsize);

        // 3. Complex Multiplication with HRTF frequency response
        // (Assuming hrtf_mem contains pre-computed complex spectrum)
        i = 0;
        loop(fftsize,
            re_L = buf_inL[i*2];   im_L = buf_inL[i*2+1];
            re_H = hrtf_mem[i*2]; im_H = hrtf_mem[i*2+1];

            // Complex multiply: (a + bi)(c + di) = (ac - bd) + (ad + bc)i
            buf_inL[i*2]   = re_L * re_H - im_L * im_H;
            buf_inL[i*2+1] = re_L * im_H + im_L * re_H;

            i += 1;
        );

        // 4. Inverse FFT
        ifft(buf_inL, fftsize);
    );

    // Output processed sample
    spl0 = buf_inL[pos * 2] / fftsize;
    spl1 = buf_inR[pos * 2] / fftsize;
);
