desc: 2x4x2 FFT Convolution of HRTF

@init
requiredSamples = 1024;
fftSize = requiredSamples * 2; // 2048-point FFT for zero-padded linear convolution

// Memory Allocation Buffers
buf_in_L   = 0;
buf_in_R   = buf_in_L + fftSize;
buf_hrtf_L = buf_in_R + fftSize;
buf_hrtf_R = buf_hrtf_L + fftSize;
buf_out_L  = buf_hrtf_R + fftSize;
buf_out_R  = buf_out_L + fftSize;
buf_overlap_L = buf_out_R + fftSize;
buf_overlap_R = buf_overlap_L + requiredSamples;

// Sample Index Pointer
pos = 0;

@sample
// 1. Buffer Incoming Audio Frame
buf_in_L[pos] = spl0;
buf_in_R[pos] = spl1;

// 2. Output Current Overlapped Samples
spl0 = buf_out_L[pos] + buf_overlap_L[pos];
spl1 = buf_out_R[pos] + buf_overlap_R[pos];

pos += 1;

// 3. Process FFT Block when Buffer is Full
pos >= requiredSamples ? (
  // Zero-pad the remaining half of the input buffers
  memset(buf_in_L + requiredSamples, 0, requiredSamples);
  memset(buf_in_R + requiredSamples, 0, requiredSamples);

  // Compute Forward Real FFT on Audio Inputs
  fft_real(buf_in_L, fftSize);
  fft_real(buf_in_R, fftSize);

  // Frequency Domain Complex Multiplication: Out = In * HRTF
  // (buf_in * buf_hrtf) -> buf_out
  i = 0;
  loop(fftSize / 2,
    re_in = buf_in_L[2*i];
    im_in = buf_in_L[2*i + 1];
    re_h  = buf_hrtf_L[2*i];
    im_h  = buf_hrtf_L[2*i + 1];

    // Complex Multiplication: (a + bi)(c + di) = (ac - bd) + (ad + bc)i
    buf_out_L[2*i]     = re_in * re_h - im_in * im_h;
    buf_out_L[2*i + 1] = re_in * im_h + im_in * re_h;

    re_inR = buf_in_R[2*i];
    im_inR = buf_in_R[2*i + 1];
    re_hR  = buf_hrtf_R[2*i];
    im_hR  = buf_hrtf_R[2*i + 1];

    buf_out_R[2*i]     = re_inR * re_hR - im_inR * im_hR;
    buf_out_R[2*i + 1] = re_inR * im_hR + im_inR * re_hR;

    i += 1;
  );

  // Compute Inverse Real FFT back to Time Domain
  ifft_real(buf_out_L, fftSize);
  ifft_real(buf_out_R, fftSize);

  // Save the second half (tail) to overlap buffer for the next block
  memcpy(buf_overlap_L, buf_out_L + requiredSamples, requiredSamples);
  memcpy(buf_overlap_R, buf_out_R + requiredSamples, requiredSamples);

  // Reset pointer
  pos = 0;
);
